# blahsum-relisten — environment overrides for docker-compose.
# Copy to .env and edit per-host. Real .env is gitignored.
#
# Defaults (used when these vars are not set) keep everything inside the
# checkout: ./audio, ./data/postgres, ./data/redis. Override on a host where
# you want bind-mounts to point elsewhere (e.g. a TrueNAS pool).

# Where to find audio files. Bind-mounted read-only into the audio nginx.
# AUDIO_DIR=/mnt/BlahNas/relisten-audio

# Postgres data dir (persistent). Put on fast storage.
# PG_DATA_DIR=/mnt/SolidStateApps/relisten/data/postgres

# Redis data dir (persistent).
# REDIS_DATA_DIR=/mnt/SolidStateApps/relisten/data/redis
