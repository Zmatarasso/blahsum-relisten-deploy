# blahsum-relisten — non-secret host settings. Copy to .env.
# Secrets go in db.env / api.env (run ./gen-secrets.sh).

# The ONE folder of audio served publicly (mounted read-only).
AUDIO_DIR=/mnt/BlahNas/Blahsum/shared/radioTracksStorage

# Postgres data (persistent).
PG_DATA_DIR=/mnt/SolidStateApps/relisten/data/postgres

# Directory shared with the host Tailscale container; the edge nginx creates
# edge.sock here and Funnel proxies to it. Nothing else should live here.
EDGE_SOCKET_DIR=/mnt/SolidStateApps/tailscale/relisten-edge

# Public URL prefix written into source_tracks.mp3_url by the importer.
AUDIO_PUBLIC_URL_BASE=https://truenas-scale.tail5a1866.ts.net:10000/audio

# Songs cut from shows by importer-watch (relisten-owned, served at /tracks/).
TRACKS_DIR_HOST=/mnt/SolidStateApps/relisten/tracks
TRACKS_PUBLIC_URL_BASE=https://truenas-scale.tail5a1866.ts.net:10000/tracks

# importer-watch writes import-status.txt here (served at /import-status.txt).
STATUS_DIR_HOST=/mnt/SolidStateApps/relisten/importer-status
